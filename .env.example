# ==========================================
# HOMINGO HACKATHON - LLM APPS TRACK
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Port Configuration
PORT=8000
FRONTEND_PORT=3000

# LLM Providers (Google Gemini / OpenAI / Anthropic)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Crustdata (Agent Data Partner - 5,000+ Credits)
# Generate from: https://app.crustdata.com/api-keys
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# Database / Storage (SQLite / PostgreSQL / ChromaDB)
DATABASE_URL=sqlite:///./local_commerce.db
VECTOR_DB_PATH=./chroma_db

# Keploy Testing Configuration
KEPLOY_MODE=record # Options: record | test | off
